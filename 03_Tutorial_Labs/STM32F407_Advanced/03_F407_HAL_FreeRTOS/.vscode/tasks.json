{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "process",
            "command": "${env:CMAKE_ROOT}/bin/cmake.exe",
            "args": ["--preset", "debug-armgcc", "--fresh"],
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": { "detail": "Configure the Debug build directory" }
            },
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "process",
            "command": "${env:CMAKE_ROOT}/bin/cmake.exe",
            "args": ["--build", "--preset", "build-debug"],
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": { "detail": "Build the STM32F407 Debug firmware" }
            },
            "dependsOrder": "sequence",
            "dependsOn": "Configure",
            "problemMatcher": "$gcc",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Rebuild All",
            "dependsOrder": "sequence",
            "dependsOn": ["Clean", "Build"],
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "${env:CMAKE_ROOT}/bin/cmake.exe",
            "args": ["--build", "--preset", "build-debug", "--target", "clean"],
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": { "detail": "Clean the Debug build artifacts" }
            },
            "problemMatcher": []
        },
        {
            "label": "CubeMX",
            "type": "process",
            "command": "${env:STM32CubeMX_PATH}/STM32CubeMX.exe",
            "args": ["${workspaceFolder}/03_F407_HAL_FreeRTOS.ioc"],
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": { "detail": "Open the project in STM32CubeMX" }
            },
            "presentation": {
                "reveal": "never",
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "Flash",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "${workspaceFolder}\\.vscode\\scripts\\flash.cmd"],
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": { "detail": "Build and flash the STM32F407 through J-Link/SWD" }
            },
            "dependsOrder": "sequence",
            "dependsOn": "Build",
            "problemMatcher": []
        }
    ]
}
