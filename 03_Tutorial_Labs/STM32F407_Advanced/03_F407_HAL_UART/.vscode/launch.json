{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (Cortex-Debug J-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "servertype": "jlink",
            "serverpath": "D:/Program Files/SEGGER/JLink_V958/JLinkGDBServerCL.exe",
            "device": "STM32F407VG",
            "interface": "swd",
            "runToEntryPoint": "main",
            "preLaunchTask": "Build",
            "gdbPath": "${env:ARM_GCC_ROOT}/bin/arm-none-eabi-gdb.exe",
            "objdumpPath": "${env:ARM_GCC_ROOT}/bin/arm-none-eabi-objdump.exe"
        }
    ]
}
